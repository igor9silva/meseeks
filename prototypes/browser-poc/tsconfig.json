{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/renderer/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src",
    "electron.vite.config.ts"
  ]
}
