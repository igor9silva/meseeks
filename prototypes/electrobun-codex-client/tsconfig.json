{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "typeRoots": [
      "../../node_modules/@types"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
