{
	"include": [".config/**/*.ts"],
	"exclude": ["node_modules", "private", "apps", "packages"],
	"compilerOptions": {
		"types": ["bun-types", "node"],
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"isolatedModules": true,
		"resolveJsonModule": true,
		"target": "ES2022",
		"allowJs": false,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	}
}
