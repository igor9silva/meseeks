{
	"name": "meseeks",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"repository": {
		"type": "git",
		"url": "https://github.com/igor9silva/meseeks.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --cwd apps/pro-web dev",
		"dev:db": "bun --cwd apps/pro-web dev:db",
		"dev:web": "bun --cwd apps/pro-web dev:web",
		"lint": "bun --cwd apps/pro-web lint",
		"format": "bun --cwd apps/pro-web format",
		"typecheck": "bun --cwd apps/pro-web typecheck",
		"test": "bun --cwd apps/pro-web test",
		"build": "bun --cwd apps/pro-web build",
		"start": "bun --cwd apps/pro-web start",
		"deploy": "bun --cwd apps/pro-web deploy",
		"sync-env-to-preview": "bun --cwd apps/pro-web sync-env-to-preview",
		"organizer": "concurrently -r 'bun --cwd apps/organizer dev' 'bun run config:watch'",
		"tasks:build": "bun run .config/generate-task-index.ts",
		"config:build": "bun run .config/generate-configs.ts",
		"config:watch": "bun run .config/watch-config.ts",
		"workspace:typecheck": "bun run --workspaces --if-present typecheck",
		"workspace:lint": "bun run --workspaces --if-present lint",
		"workspace:format": "bun run --workspaces --if-present format",
		"workspace:test": "bun run --workspaces --if-present test",
		"workspace:check": "bun workspace:lint && bun workspace:typecheck && bun workspace:test",
		"skills:deploy:dev": "cd private/skills && bun deploy.ts --env dev",
		"skills:deploy:prod": "cd private/skills && bun deploy.ts --env prod",
		"skills:deploy:dev:delete": "cd private/skills && bun deploy.ts --env dev --delete-unspecified",
		"skills:deploy:prod:delete": "cd private/skills && bun deploy.ts --env prod --delete-unspecified"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"bun-types": "latest",
		"concurrently": "~8.2.2",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1",
		"zod": "^3.25.76"
	}
}
