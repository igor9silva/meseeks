{
	"name": "companion",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/igor9silva/meseeks.git"
	},
	"scripts": {
		"dev": "concurrently -r bun:dev:web bun:dev:db",
		"dev:web": "vite dev --port 3000",
		"dev:db": "bunx convex dev",
		"build": "vite build",
		"start": "bun .output/server/index.mjs",
		"typecheck": "bunx tsc --noEmit",
		"lint": "prettier --check '**/*' '!data/**' --ignore-unknown && eslint --ext .ts,.tsx ./src",
		"format": "prettier --write '**/*' '!data/**' --ignore-unknown",
		"skills:deploy:dev": "cd data/skills && bun deploy.ts --env dev",
		"skills:deploy:prod": "cd data/skills && bun deploy.ts --env prod",
		"skills:deploy:dev:delete": "cd data/skills && bun deploy.ts --env dev --delete-unspecified",
		"skills:deploy:prod:delete": "cd data/skills && bun deploy.ts --env prod --delete-unspecified"
	},
