{
	"name": "meseeks",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"repository": {
		"type": "git",
		"url": "https://github.com/igor9silva/meseeks.git"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"app:dev": "bun run --filter @meseeks/app dev",
		"app:dev:db": "bun run --filter @meseeks/app dev:db",
		"app:dev:web": "bun run --filter @meseeks/app dev:web",
		"app:build": "bun run --filter @meseeks/app build",
		"app:deploy": "bun run --filter @meseeks/app deploy",
		"app:start": "bun run --filter @meseeks/app start",
		"app:typecheck": "bun run --filter @meseeks/app typecheck",
		"app:lint": "bun run --filter @meseeks/app lint",
		"app:format": "bun run --filter @meseeks/app format",
		"organizer:dev": "concurrently -r bun:organizer:app bun:config:watch",
		"organizer:app": "bun run --filter @meseeks/organizer dev",
		"config:build": "bun run .config/generate-configs.ts",
		"config:watch": "bun run .config/watch-config.ts",
		"tasks:build": "bun run .config/generate-task-index.ts",
		"workspace:typecheck": "bun run --workspaces --if-present typecheck",
		"workspace:lint": "bun run --workspaces --if-present lint",
		"workspace:test": "bun run --workspaces --if-present test",
		"workspace:build": "bun run app:build && bun run --filter @meseeks/organizer build && bun run --filter @meseeks/check-verse build",
		"skills:deploy:dev": "cd private/skills && bun deploy.ts --env dev",
		"skills:deploy:prod": "cd private/skills && bun deploy.ts --env prod",
		"skills:deploy:dev:delete": "cd private/skills && bun deploy.ts --env dev --delete-unspecified",
		"skills:deploy:prod:delete": "cd private/skills && bun deploy.ts --env prod --delete-unspecified"
	},
	"devDependencies": {
		"@types/node": "^25.0.3",
		"bun-types": "latest",
		"concurrently": "~8.2.2",
		"prettier": "3.2.5",
		"zod": "^3.25.76"
	}
}
