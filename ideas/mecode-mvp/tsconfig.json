{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"lib": [
			"ES2023",
			"DOM"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"electrobun.config.ts",
		"src/**/*.ts",
		"backend/**/*.ts",
		"types/**/*.d.ts"
	]
}
